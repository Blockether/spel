.</p><p lang=es>Este dominio está destinado al uso en ejemplos de documentación sin necesidad de permiso. Esto no es un servicio, evitar utilizarlo para realizar pruebas o monitoreos.</p>\");B.insertAdjacentHTML(\"afterbegin\",'<style>body{padding:2em 2em 20vh;place-items:center}svg{opacity:.55}p{grid-area:2/1}span{transition:opacity .4s}p+p span{opacity:0}@media(prefers-reduced-motion){*{transition:none}}</style><svg viewBox=0,0,20,20 width=44 height=44 fill=currentColor aria-hidden=true><path fill=none stroke=currentColor stroke-width=1.3 stroke-linejoin=round d=\"M6 4H3v12q4 0 7 1.5-1-3.5-4-4.5V2q3.5 1 4 3v12.5q3-1.5 7-1.5V4q-4.5 0-7 1\"/><g transform=rotate(-6,13.6,8.3)><path id=q d=\"M11.5 6.6h1.8v1.8l-1 1.6-.6-.3.8-1.3h-1z\"/><use href=#q x=2.4 /></g></svg>');P=B.querySelectorAll(\"p\");for(i=j=0;p=P[j];j++)\np.innerHTML=p.textContent.replace(p.lang==\"ar\"?/ ?\\S+/g:/./gu,\"<span>$&</span>\");f=(p,v,d)=>[...p.children].map((e,k,c)=>(e=e.style,e.transitionDelay=d+k*500/c.length+\"ms\",e.opacity=v));setInterval(_=>{f(P[i],0,0);f(P[i=++i%6],1,300);},5e3)\n"},"headersSize":0,"bodySize":1597,"redirectURL":"","_transferSize":1597},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":16.143,"receive":1.459},"_resourceType":"script","serverIPAddress":"172.66.157.237","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"example.org","issuer":"Cloudflare TLS Issuing ECC CA 3","validFrom":1790460305,"validTo":1798236807}}]}}