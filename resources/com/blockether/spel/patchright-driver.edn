 ;; checks the integrity hash and packs it as the Maven artifact
 ;; com.blockether/spel-patchright-driver <:version> with the same
 ;; `driver/package/**` layout as com.microsoft.playwright/driver.
 ;; Keep :version on the Playwright Java minor line in deps.edn.
 :package   "patchright-core"
 :version   "1.64.3"
 :integrity "sha512-AikBjQ6CcsEtk7pJGlZ7ITxIInVd0a8HWPtuGjx2Y0Ogb88sj1wqICiYFz4du6fbaLQStLNEnWCmYm5uODsEzQ=="}
