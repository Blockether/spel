(ns {{ns}}.e2e.seed-test
  "Smoke-test scaffold with isolated browser setup.
   Replace the example URL and assertions with the requested application."
  (:require
   [clojure.test :refer [deftest testing is]]
   [com.blockether.spel.core :as core]
   [com.blockether.spel.page :as page]))

(deftest homepage-test
  (testing "loads successfully"
    (core/with-testing-page [page]
      (page/navigate page "https://example.com")
      (is (= "Example Domain" (page/title page))))))
